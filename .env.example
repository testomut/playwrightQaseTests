# Copy to .env and fill in real values for your own environment.
# None of these point anywhere real - see README.md "Why the suite is
# not runnable as published".

# --- Application ---
# Base URL and target environment name of the app under test.
ENVIRONMENT_URL=https://qa.qatest.com
ENV=qa
# Name of the auth cookie for the selected ENV (one var per environment).
TOKEN_qa=auth_token_qa
TOKEN_stage=auth_token_stage

# --- Authentication ---
# HTTP basic-auth credentials, for environments gated behind one.
BASIC_USERNAME=basic-auth-user
BASIC_PASSWORD=basic-auth-password
# A standing (non-disposable) test account used as a stable message
# recipient/sender across specs, instead of creating one per run.
OLD_ACCOUNT_EMAIL=old-account@qatest.com
OLD_ACCOUNT_PASS=change-me
OLD_ACCOUNT_PHONE_qa=15550000000
OLD_ACCOUNT_PHONE_stage=15550000001
# Internal team ID the old account sends messages through.
OLD_ACCOUNT_TEAM_ID=1

# --- Qase TestOps ---
# See ARCHITECTURE.md "Qase integration" - reporting requires a real
# Qase workspace and token; QASE_MODE=off keeps the framework from
# trying to report anywhere by default.
QASE_MODE=off
QASE_TESTOPS_API_TOKEN=
QASE_RUN_ID=

# --- Email (IMAP) ---
# Gmail inbox used by EmailService to verify transactional email.
EMAIL_GMAIL=test-inbox@gmail.com
EMAIL_GMAIL_PASS=app-password

# --- Runtime ---
# Parallel worker count used by both Playwright configs.
WORKERS=5
